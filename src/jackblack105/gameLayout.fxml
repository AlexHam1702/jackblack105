<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="jackblack105.GameController"
            style="-fx-background-color: #006400;"> <!-- Casino Green Background -->

    <!-- DEALER AREA (TOP) -->
    <top>
        <VBox fx:id="dealerArea" alignment="CENTER" spacing="15">
            <padding>
                <Insets top="30" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Croupier" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <!-- Later, you can inject a dynamically created HBox here for the dealer's cards -->
        </VBox>
    </top>

    <!-- PLAYERS AREA (CENTER) -->
    <center>
        <HBox fx:id="playersContainer" alignment="CENTER" spacing="50">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <!-- The GameController's buildPlayersUI() method will inject the players' VBoxes right here -->
        </HBox>
    </center>

    <!-- CONTROLS AREA (BOTTOM) -->
    <bottom>
        <HBox alignment="CENTER" spacing="30">
            <padding>
                <Insets top="20" right="20" bottom="40" left="20"/>
            </padding>
            <Button fx:id="btnTirer" text="Tirer (Hit)" onAction="#handleHit" 
                    style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;"/>
            
            <Button fx:id="btnRester" text="Rester (Stand)" onAction="#handleStand" 
                    style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </HBox>
    </bottom>

</BorderPane>